# Copy to .env (git-ignored). Dev defaults shown; production values go in Vercel env vars.

# Database (dev compose service "db"; on Vercel the Neon Marketplace integration provides the URL)
POSTGRES_DB=clienthub
POSTGRES_USER=clienthub
POSTGRES_PASSWORD=clienthub
ConnectionStrings__Default=Host=db;Port=5432;Database=clienthub;Username=clienthub;Password=clienthub

# S3-compatible storage (SeaweedFS in dev, Cloudflare R2 in preview and production)
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clienthub-files
S3_ACCESS_KEY_ID=clienthub
S3_SECRET_ACCESS_KEY=clienthub-dev-secret
S3_FORCE_PATH_STYLE=true

# App
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
SEED_PASSWORD=ChangeMe-Dev-123!
REQUIRE_FIRM_2FA=true
# 32+ character key used to encrypt the SMTP password stored in firm_settings
SMTP_ENCRYPTION_KEY=dev-only-change-me-32-chars-minimum-key
APP_BASE_URL=http://localhost:5000
