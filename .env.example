# Copy to .env (git-ignored). Dev defaults shown; production values go in Vercel env vars.

# Database (dev compose service "db"; on Vercel the Neon Marketplace integration provides the URL)
POSTGRES_DB=clienthub
POSTGRES_USER=clienthub
POSTGRES_PASSWORD=clienthub
ConnectionStrings__Default=Host=db;Port=5432;Database=clienthub;Username=clienthub;Password=clienthub
# Alternative to ConnectionStrings__Default: a postgres:// URL (Neon). On Vercel the Neon integration sets DATABASE_URL.
# DATABASE_URL=

# S3-compatible storage (SeaweedFS in dev, Cloudflare R2 in preview and production)
S3_ENDPOINT=http://storage:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clienthub-files
S3_ACCESS_KEY_ID=clienthub
S3_SECRET_ACCESS_KEY=clienthub-dev-secret

# App
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
SEED_PASSWORD=ChangeMe-Dev-123!
# Lawyer and Office Manager must set up 2FA before using the staff area. Set false only in a local .env for manual checks.
REQUIRE_FIRM_2FA=true
APP_BASE_URL=http://localhost:5000
# Production only: the app refuses to start without it. Public origin, no trailing path (email links and AllowedHosts derive from it).
# Preview deployments need their own value, or set AllowedHosts (below) to the preview host.
# AllowedHosts=
# Optional: seconds between security-stamp checks (default 60).
# SECURITY_STAMP_INTERVAL_SECONDS=60
