@model InputModel
@{
    var id = Model.Name.Replace('.', '_');
    var errors = ViewContext.ViewData.ModelState.TryGetValue(Model.Name, out var entry) ? entry.Errors : null;
    var hasError = errors is { Count: > 0 };
}
<div class="space-y-1">
    <label for="@id" class="block text-badge text-text-secondary">@Model.Label</label>
    <input id="@id" name="@Model.Name" type="@Model.Type" value="@(Model.Type == "password" ? null : Model.Value)"
           autocomplete="@Model.Autocomplete" inputmode="@Model.InputMode"
           class="input @(hasError ? "input-error" : "")" required="@Model.Required" autofocus="@Model.Autofocus" readonly="@Model.ReadOnly"
           aria-invalid="@(hasError ? "true" : null)" />
    @if (hasError)
    {
        foreach (var e in errors!)
        {
            <p class="text-caption text-danger">@e.ErrorMessage</p>
        }
    }
    else if (Model.Hint is not null)
    {
        <p class="text-caption text-text-muted">@Model.Hint</p>
    }
</div>
