@model CaseCardModel
<a href="@Model.Href" class="card block min-h-[44px] space-y-2 hover:border-border-strong">
    <div class="flex items-start justify-between gap-3">
        <h3 class="text-h3">@Model.Title</h3>
        <partial name="Components/_StatusBadge" model="Model.Status" />
    </div>
    <p class="text-caption text-text-secondary">
        @L["CaseType." + Model.CaseType] · @L["Common.Case.Opened"] @Format.Date(Model.OpenedAt)
    </p>
    <p class="text-caption text-text-muted">
        @L["Common.Case.LastUpdate"]: @(Model.LastUpdateAt is null ? L["Common.None"].Value : Format.Date(Model.LastUpdateAt))
    </p>
</a>
