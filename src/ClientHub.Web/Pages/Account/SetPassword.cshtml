@page
@model ClientHub.Web.Pages.Account.SetPasswordModel
@{
    ViewData["Title"] = L["Account.SetPassword.Title"];
    var pw = new InputModel("Password", L["Account.SetPassword.New"], Type: "password", Autocomplete: "new-password", Required: true, Hint: L["Account.SetPassword.Rules"]);
    var confirm = new InputModel("ConfirmPassword", L["Account.SetPassword.Confirm"], Type: "password", Autocomplete: "new-password", Required: true);
    var save = new ButtonModel(L["Account.SetPassword.Save"], FullWidth: true);
    var back = new ButtonModel(L["Account.Common.BackToLogin"], ButtonVariant.Ghost, Href: "/Account/Login", FullWidth: true);
}
<h1 class="text-h1">@L["Account.SetPassword.Title"]</h1>
@if (Model.Error is not null)
{
    <p class="rounded-control bg-danger-bg px-3 py-2 text-body-sm text-danger" role="alert">@Model.Error</p>
}
<form method="post" class="space-y-4" novalidate>
    <input type="hidden" name="UserId" value="@Model.UserId" />
    <input type="hidden" name="Code" value="@Model.Code" />
    <partial name="Components/_Input" model="pw" />
    <partial name="Components/_Input" model="confirm" />
    <partial name="Components/_Button" model="save" />
</form>
<partial name="Components/_Button" model="back" />
