@page
@model ClientHub.Web.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = L["Account.LoginWith2fa.Title"];
    var code = new InputModel("Code", L["Account.LoginWith2fa.Code"], Autocomplete: "one-time-code", Required: true, InputMode: "numeric", Autofocus: true, Hint: L["Account.LoginWith2fa.Hint"]);
    var verify = new ButtonModel(L["Account.LoginWith2fa.Verify"], FullWidth: true);
    var back = new ButtonModel(L["Account.Common.BackToLogin"], ButtonVariant.Ghost, Href: "/Account/Login", FullWidth: true);
}
<h1 class="text-h1">@L["Account.LoginWith2fa.Title"]</h1>
<p class="text-body-sm text-text-secondary">@L["Account.LoginWith2fa.Intro"]</p>
@if (Model.Error is not null)
{
    <p class="rounded-control bg-danger-bg px-3 py-2 text-body-sm text-danger" role="alert">@Model.Error</p>
}
<form method="post" class="space-y-4" novalidate>
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <partial name="Components/_Input" model="code" />
    <partial name="Components/_Button" model="verify" />
</form>
<partial name="Components/_Button" model="back" />
