@page
@model ClientHub.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = L["Account.Forgot.Title"];
    var email = new InputModel("Email", L["Account.Login.Email"], Model.Email, "email", "username", Required: true, InputMode: "email", Autofocus: true);
    var send = new ButtonModel(L["Account.Forgot.Send"], FullWidth: true);
    var back = new ButtonModel(L["Account.Common.BackToLogin"], ButtonVariant.Ghost, Href: "/Account/Login", FullWidth: true);
}
<h1 class="text-h1">@L["Account.Forgot.Title"]</h1>
@if (Model.Sent)
{
    <p class="rounded-control bg-success-bg px-3 py-2 text-body-sm text-success" role="status">@L["Account.Forgot.Sent"]</p>
}
else
{
    <p class="text-body-sm text-text-secondary">@L["Account.Forgot.Intro"]</p>
    <form method="post" class="space-y-4" novalidate>
        <partial name="Components/_Input" model="email" />
        <partial name="Components/_Button" model="send" />
    </form>
}
<partial name="Components/_Button" model="back" />
