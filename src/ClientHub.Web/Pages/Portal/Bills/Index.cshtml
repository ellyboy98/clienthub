@page
@model ClientHub.Web.Pages.Portal.Bills.IndexModel
@{
    ViewData["Title"] = L["Portal.Nav.Bills"];
    var empty = new EmptyStateModel(L["Portal.Bills.Empty"]);
}
<div class="space-y-4">
    <h1 class="text-h1">@L["Portal.Nav.Bills"]</h1>
    @if (Model.Rows.Count == 0)
    {
        <partial name="Components/_EmptyState" model="empty" />
    }
    else
    {
        <partial name="/Pages/Portal/Bills/_BillCards.cshtml" model="Model.Rows" />
    }
</div>
