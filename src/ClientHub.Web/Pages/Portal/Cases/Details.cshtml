@page "{id:guid}"
@model ClientHub.Web.Pages.Portal.Cases.DetailsModel
@using ClientHub.Web.Data.Entities
@{
    var c = Model.Case;
    ViewData["Title"] = c.Title;
    var baseUrl = $"/Portal/Cases/Details/{c.Id}";
    var tabs = new TabsModel(new[]
    {
        new TabItem(L["Portal.Case.Tab.Updates"], baseUrl, Model.Tab == DetailsModel.TabUpdates),
        new TabItem(L["Portal.Case.Tab.Documents"], baseUrl + "?tab=" + DetailsModel.TabDocuments, Model.Tab == DetailsModel.TabDocuments),
        new TabItem(L["Portal.Case.Tab.Bills"], baseUrl + "?tab=" + DetailsModel.TabBills, Model.Tab == DetailsModel.TabBills),
    });
    var noUpdates = new EmptyStateModel(L["Portal.Case.NoUpdates"]);
    var noBills = new EmptyStateModel(L["Portal.Bills.Empty"]);
    var noDocuments = new EmptyStateModel(L["Portal.Case.NoDocuments"]);
    var back = c.IsClosed ? "/Portal/Cases/Past" : "/Portal/Cases";
}
@section Header {
    <header class="bg-brand-navy px-5 pb-6 pt-4 text-white">
        <div class="mx-auto flex max-w-2xl items-center justify-between">
            <a href="@back" class="inline-flex h-11 w-11 items-center justify-center rounded-full text-white" aria-label="@L["Common.Back"]">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"/></svg>
            </a>
            <partial name="/Pages/Portal/_PortalHeader.cshtml" />
        </div>
        <div class="mx-auto mt-3 max-w-2xl space-y-2">
            <h1 class="text-h1">@c.Title</h1>
            <div class="flex flex-wrap items-center gap-2">
                <partial name="Components/_StatusBadge" model="c.Status" />
                <span class="text-caption text-white/70">@L["CaseType." + c.CaseType] · @L["Common.Case.Opened"] @Format.Date(c.OpenedAt)</span>
            </div>
            <p class="text-body-sm text-white/80">@L["Portal.Case.Lawyer"]: @c.Lawyer?.DisplayName</p>
        </div>
    </header>
}
<div class="space-y-4">
    @if (c.Description is not null)
    {
        <section class="card">
            <h2 class="mb-1 text-badge text-text-secondary">@L["Portal.Case.About"]</h2>
            <p class="whitespace-pre-line text-body-sm">@c.Description</p>
        </section>
    }
    @if (Model.OpenRequests.Count > 0)
    {
        <section class="rounded-card border border-warning/30 bg-warning-bg p-4 shadow-card" data-needed>
            <h2 class="mb-3 text-h3 text-warning">@L["Portal.Home.StillNeed"]</h2>
            <ul class="space-y-4">
                @foreach (var r in Model.OpenRequests)
                {
                    var rejected = r.Status == RequestStatus.Rejected;
                    var upload = FileUploadModel.ForCase($"upload-{r.Id:N}", L[rejected ? "Portal.Case.Reupload" : "Portal.Home.Upload"], c.Id, r.Id, showHint: false);
                    <li class="space-y-2" data-request="@r.Id">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <p class="text-label">@r.Name</p>
                                @if (r.Note is not null) { <p class="whitespace-pre-line text-caption text-text-secondary">@r.Note</p> }
                                @if (rejected && r.RejectionReason is not null) { <p class="text-caption text-danger">@L["Common.Request.Reason"]: @r.RejectionReason</p> }
                            </div>
                            <partial name="Components/_StatusBadge" model="r.Status" />
                        </div>
                        <partial name="Components/_FileUpload" model="upload" />
                    </li>
                }
            </ul>
            <p class="mt-3 text-caption text-text-muted">@L["Common.Upload.Hint"]</p>
        </section>
    }
    @if (Model.ReceivedRequests.Count > 0)
    {
        <section class="card space-y-3" data-received>
            <h2 class="text-h3">@L["Portal.Case.ReceivedRequests"]</h2>
            <ul class="divide-y divide-border">
                @foreach (var r in Model.ReceivedRequests)
                {
                    <li class="flex items-center justify-between gap-2 py-2" data-request="@r.Id">
                        <p class="min-w-0 truncate text-label">@r.Name</p>
                        <partial name="Components/_StatusBadge" model="r.Status" />
                    </li>
                }
            </ul>
        </section>
    }
    <partial name="Components/_Tabs" model="tabs" />
    @if (Model.Tab == DetailsModel.TabUpdates)
    {
        if (Model.Updates.Count == 0)
        {
            <partial name="Components/_EmptyState" model="noUpdates" />
        }
        else
        {
            <ol class="space-y-3" data-updates>
                @foreach (var u in Model.Updates)
                {
                    <li class="card space-y-1">
                        <p class="text-caption text-text-secondary">@Format.Date(u.PostedAt)</p>
                        <p class="whitespace-pre-line text-body-sm">@u.Body</p>
                    </li>
                }
            </ol>
        }
    }
    else if (Model.Tab == DetailsModel.TabDocuments)
    {
        if (Model.Documents.Count == 0)
        {
            <partial name="Components/_EmptyState" model="noDocuments" />
        }
        else
        {
            <ul class="space-y-3" data-documents>
                @foreach (var d in Model.Documents)
                {
                    <li class="card flex items-center justify-between gap-3" data-document="@d.Id">
                        <div class="min-w-0">
                            <p class="truncate text-label">@d.FileName</p>
                            <p class="text-caption text-text-secondary">@Format.FileSize(d.SizeBytes) · @Format.Date(d.UploadedAt)</p>
                        </div>
                        <a href="/Files/Download/@d.Id" class="btn btn-secondary shrink-0">@L["Common.Download"]</a>
                    </li>
                }
            </ul>
        }
    }
    else if (Model.Bills.Count == 0)
    {
        <partial name="Components/_EmptyState" model="noBills" />
    }
    else
    {
        <partial name="/Pages/Portal/Bills/_BillCards.cshtml" model="Model.Bills" />
    }
</div>
