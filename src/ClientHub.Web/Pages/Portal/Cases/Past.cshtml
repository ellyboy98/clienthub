@page
@model ClientHub.Web.Pages.Portal.Cases.PastModel
@{
    ViewData["Title"] = L["Portal.Cases.Past"];
    var empty = new EmptyStateModel(L["Portal.Cases.PastEmpty"]);
    var back = new ButtonModel(L["Portal.Cases.Title"], ButtonVariant.Ghost, Href: "/Portal/Cases");
}
<div class="space-y-4">
    <div class="flex items-center justify-between">
        <h1 class="text-h1">@L["Portal.Cases.Past"]</h1>
        <partial name="Components/_Button" model="back" />
    </div>
    @if (Model.Cases.Count == 0)
    {
        <partial name="Components/_EmptyState" model="empty" />
    }
    @foreach (var c in Model.Cases)
    {
        var card = new CaseCardModel(c.Title, c.Status, c.CaseType, c.OpenedAt, c.LastUpdateAt, $"/Portal/Cases/Details/{c.Id}");
        <partial name="Components/_CaseCard" model="card" />
    }
</div>
