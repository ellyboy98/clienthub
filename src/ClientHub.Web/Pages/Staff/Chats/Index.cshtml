@page
@model ClientHub.Web.Pages.Staff.Chats.IndexModel
@{
    ViewData["Title"] = L["Staff.Chats.Title"];
    var list = new ClientHub.Web.Pages.Staff.Chats.ChatListModel(Model.Items, null);
}
<div class="space-y-5">
    <h1 class="text-h1">@L["Staff.Chats.Title"]</h1>
    <div class="grid gap-5 lg:grid-cols-[320px_1fr]">
        <partial name="_ChatList" model="list" />
        @if (Model.Items.Count > 0)
        {
            <div class="card hidden items-center justify-center py-16 text-body-sm text-text-secondary lg:flex">@L["Staff.Chats.Choose"]</div>
        }
    </div>
</div>
